# ---- 服务 ----
JIMENG2API_HOST=127.0.0.1
JIMENG2API_PORT=8300
JIMENG2API_DATA=./data
# JIMENG2API_DB=./data/jimeng2api.db
JIMENG2API_LOG_LEVEL=INFO

# 首次启动若不设，会自动生成并写入 data/first_boot_key.txt（权限 600）
# JIMENG2API_ADMIN_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
JIMENG2API_REQUIRE_AUTH=1
JIMENG2API_COORDINATOR=1
# 后编辑族里草稿形态未取证的能力默认关闭（`Ability.experimental`）。
# 当前**没有**这样的能力（超清/细节修复/重绘/消除笔/扩图/抠图均已取证），
# 机制保留给未来的新能力；置 1 = 允许用真实提交去试探上游，失败也可能计费
# JIMENG2API_POSTEDIT_EXPERIMENTAL=1
# 后编辑作品的归属工作区；0 = 账号默认工作区（UI 会新建，网关不建）
# JIMENG2API_WORKSPACE_ID=0

# ---- 上游站点（国内站，默认值即当前抓包实测值）----
JIMENG_BASE=https://jimeng.jianying.com
JIMENG_ORIGIN=https://jimeng.jianying.com
JIMENG_AID=513695
JIMENG_DA_VERSION=3.3.40
JIMENG_WEB_VERSION=7.5.0
JIMENG_APP_SDK_VERSION=48.0.0
JIMENG_APPVR=8.4.0
JIMENG_PF=7
# 出站代理（可选）
# JIMENG2API_HTTP_PROXY=http://127.0.0.1:7890
# 浏览器 secsdk 运行时头（正常不需要；只有上游开始强校验时才填）
# JIMENG_SECSDK_SIGNATURE=
# JIMENG_SECSDK_EXPIRE=
